@tool
class_name RobotArtBuilder
extends Node
## Builds a Robot Art URDF with any number of layers: a fixed gantry bar on top,
## then layer 1, 2, ... N hanging below it, and the pen at the end of the last arm.
## Same robot as `xacro epicycle_layers.urdf.xacro layers:=N rest_radius:=0.07`.
##
## Use: add this node to your scene, set Layers, point Arm Rig at your ImportRobot
## (and Joint Controller at your ArmController), then press "Build robot".

@export_range(1, 10) var layers: int = 3
## Length of every layer's guide rails (m), except the top layer's: its motor never
## moves, so it only gets a 30 mm stub. Each motor can travel +/-(length/2 - 8 mm) along them.
@export_range(0.05, 2.0, 0.01, "suffix:m") var track_length: float = 0.5
## Arm radius in the URDF's zero pose (m). Godot needs a real radius here (0.03..0.17).
@export var rest_radius: float = 0.07
## Where the URDF is written. %d is replaced by the number of layers.
@export var output_path: String = "res://robot_art/robot_art_%d_layers.urdf"
## Optional: an ImportRobot (arm_rig.gd) node. After building, it is pointed at the
## new file and reloaded.
@export var arm_rig: Node
## Optional: the RobotJointController that drives it. Its joint offsets are set so
## clampB values are the true radius in metres.
@export var joint_controller: RobotJointController
## Also build when the game starts (handy while you change Layers often).
@export var build_on_ready: bool = false

@export_tool_button("Build robot", "Reload") var _build_button = build

const MESHES := "package://robot_art_layer/meshes/"
const LAYER_DROP := 0.1363      # height of one layer (bar centre line to the next bar's)
const PEN_DROP := 0.140         # last bar centre line -> pen tip
const PIVOT_Z := -0.0237        # bar centre line -> top pivot
const MOTOR_Z := -0.0759        # top pivot -> motor face (bottom pivot)
const CLAMPB_Z := -0.0367       # motor face -> next bar centre line
const TRACK_X := 0.242          # ball units sit this far either side of the bar centre
const TRACK_FLOOR := -0.0477    # top pivot -> track floor
const SLIDE_MAX := 0.214
const R_MIN := 0.03
const R_MAX := 0.17


func _ready() -> void:
	if build_on_ready and not Engine.is_editor_hint():
		build()


## Writes the URDF, then (if set) reloads Arm Rig and sets the controller's offsets.
func build() -> void:
	var path := output_path % layers if output_path.contains("%d") else output_path
	var f := FileAccess.open(path, FileAccess.WRITE)
	if f == null:
		push_error("RobotArtBuilder: can't write %s (%s)" % [path, error_string(FileAccess.get_open_error())])
		return
	f.store_string(make_urdf(layers, rest_radius, track_length))
	f.close()
	# meshes are found under res://robot_art whatever loads the file
	var cfg := FileAccess.open(path.get_basename() + ".yaml", FileAccess.WRITE)
	if cfg:
		cfg.store_string('package_folder: "%s"\n' % path.get_base_dir())
		cfg.close()
	print("RobotArtBuilder: wrote %d-layer robot to %s" % [layers, path])
	if Engine.is_editor_hint():
		EditorInterface.get_resource_filesystem().scan()

	if joint_controller:
		var offsets: Dictionary[String, float] = {}
		for i in range(1, layers + 1):
			offsets["clampB%d" % i] = rest_radius
		joint_controller.joint_offsets = offsets
	if arm_rig:
		arm_rig.set("urdf_file_path", path)
		arm_rig.set("package_folder", path.get_base_dir())
		if arm_rig.has_method("load_robot"):
			arm_rig.call("load_robot")


# ---------------------------------------------------------------- URDF text

static func make_urdf(n: int, r0: float, track_len: float = 0.5) -> String:
	var top_z := n * LAYER_DROP + PEN_DROP
	var s := PackedStringArray()
	s.append('<?xml version="1.0"?>')
	s.append('<!-- Robot Art: %d layers, generated by robot_art_builder.gd (rest_radius %s).' % [n, _f(r0)])
	s.append('     joint1..%d = arm directions (rad), clampB1..%d = radius - %s (m),' % [n, n, _f(r0)])
	s.append('     support1..%d = passive bar slides, pivot2..%d = mimic (-joint above). -->' % [n, n])
	s.append('<robot name="robot_art_%d_layers">' % n)
	s.append(_materials())
	s.append('  <link name="world"/>')
	s.append(_fixed("gantry_fixed", "world", "bar0", "0 0 %s" % _f(top_z)))
	s.append(_bar_link("bar0"))
	for i in range(1, n + 1):
		s.append(_layer(i, r0, top_z, track_len))
	s.append(_fixed("pen_mount", "bar%d" % n, "pen", "0 0 -0.010"))
	s.append('''  <link name="pen">
	<visual><origin xyz="0 0 -0.015"/><geometry><box size="0.03 0.03 0.03"/></geometry><material name="orange"/></visual>
	<visual><origin xyz="0 0 -0.080"/><geometry><cylinder radius="0.005" length="0.100"/></geometry><material name="red"/></visual>
	<collision><origin xyz="0 0 -0.080"/><geometry><cylinder radius="0.005" length="0.100"/></geometry></collision>
	<inertial><origin xyz="0 0 -0.04"/><mass value="0.03"/><inertia ixx="2e-5" ixy="0" ixz="0" iyy="2e-5" iyz="0" izz="1e-6"/></inertial>
  </link>''')
	s.append(_fixed("pen_tip_mount", "pen", "pen_tip", "0 0 -0.130"))
	s.append('  <link name="pen_tip"><inertial><mass value="0.001"/><inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/></inertial></link>')
	s.append('</robot>')
	return "\n".join(s) + "\n"


static func _layer(i: int, r0: float, top_z: float, track_len: float) -> String:
	var s := PackedStringArray()
	s.append('  <!-- ===== layer %d ===== -->' % i)
	s.append(_fixed("clampA%d" % i, "bar%d" % (i - 1), "clampA%d" % i, "0 0 0"))
	s.append('''  <link name="clampA%d">
	<visual><geometry><mesh filename="%sclampA.stl" scale="0.001 0.001 0.001"/></geometry><material name="orange"/></visual>
	<collision><geometry><box size="0.040 0.028 0.0284"/></geometry></collision>
	<collision><origin xyz="0 0 -0.0207"/><geometry><cylinder radius="0.015" length="0.013"/></geometry></collision>
	<inertial><origin xyz="-0.00011 0.00000 -0.01275"/><mass value="0.0280"/><inertia ixx="6.2275e-06" ixy="-7.0054e-12" ixz="3.6730e-08" iyy="7.7408e-06" iyz="6.4456e-10" izz="4.3962e-06"/></inertial>
  </link>''' % [i, MESHES])
	if i == 1:
		s.append(_fixed("pivot1", "clampA1", "motor1", "0 0 %s" % _f(PIVOT_Z)))
	else:
		s.append('''  <joint name="pivot%d" type="continuous">
	<parent link="clampA%d"/><child link="motor%d"/><origin xyz="0 0 %s" rpy="0 0 %s"/>
	<axis xyz="0 0 1"/><limit effort="0" velocity="10"/><dynamics friction="0.002" damping="0.0"/>
	<mimic joint="joint%d" multiplier="-1" offset="0"/>
  </joint>''' % [i, i, i, _f(PIVOT_Z), _f(-PI / 2.0), i - 1])
	s.append('''  <link name="motor%d">
	<visual><geometry><mesh filename="%smotor.stl" scale="0.001 0.001 0.001"/></geometry><material name="dark"/></visual>
	<collision><origin xyz="0 0 -0.0237"/><geometry><box size="0.040 0.028 0.0304"/></geometry></collision>
	<collision><origin xyz="0 0 -0.0594"/><geometry><box size="0.0543 0.0543 0.041"/></geometry></collision>
	<inertial><origin xyz="0.00009 -0.00000 -0.05783"/><mass value="0.2011"/><inertia ixx="9.6019e-05" ixy="-3.2819e-11" ixz="5.4181e-09" iyy="9.6824e-05" iyz="-4.1809e-09" izz="5.7848e-05"/></inertial>
  </link>''' % [i, MESHES])
	s.append('''  <joint name="support%d" type="prismatic">
	<parent link="motor%d"/><child link="support%d_bar"/><origin xyz="0 0 0"/><axis xyz="1 0 0"/>
	<limit lower="%s" upper="%s" effort="0" velocity="1.0"/><dynamics friction="0.5" damping="0.0"/>
  </joint>
  <link name="support%d_bar">
	<visual><geometry><mesh filename="%ssupport.stl" scale="0.001 0.001 0.001"/></geometry><material name="steel"/></visual>
	<collision><origin xyz="0 0 -0.0247"/><geometry><box size="0.50 0.02 0.02"/></geometry></collision>
	<collision><origin xyz="%s 0 -0.0387"/><geometry><cylinder radius="0.008" length="0.008"/></geometry></collision>
	<collision><origin xyz="%s 0 -0.0387"/><geometry><cylinder radius="0.008" length="0.008"/></geometry></collision>
	<inertial><origin xyz="0 0 -0.02559"/><mass value="0.2660"/><inertia ixx="2.4046e-05" ixy="0" ixz="0" iyy="6.1592e-03" iyz="0" izz="6.1560e-03"/></inertial>
  </link>''' % [i, i, i, _f(-SLIDE_MAX), _f(SLIDE_MAX), i, MESHES, _f(-TRACK_X), _f(TRACK_X)])
	s.append(_fixed("encoder%d_mount" % i, "motor%d" % i, "encoder%d" % i, "0 0 -0.0479"))
	s.append('  <link name="encoder%d"><inertial><mass value="0.001"/><inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/></inertial></link>' % i)
	s.append('''  <joint name="joint%d" type="continuous">
	<parent link="motor%d"/><child link="hub%d"/><origin xyz="0 0 %s"/><axis xyz="0 0 1"/>
	<limit effort="0.13" velocity="1.0"/><dynamics damping="0.0"/>
  </joint>
  <link name="hub%d">
	<visual><geometry><mesh filename="%shub.stl" scale="0.001 0.001 0.001"/></geometry><material name="orange"/></visual>
	<collision><origin xyz="0 0 -0.0135"/><geometry><cylinder radius="0.011" length="0.018"/></geometry></collision>
	<collision><origin xyz="0 0 %s"/><geometry><box size="0.040 0.028 0.0284"/></geometry></collision>
	<inertial><origin xyz="-0.00000 0.00004 -0.02232"/><mass value="0.0208"/><inertia ixx="5.9366e-06" ixy="3.9488e-16" ixz="-1.5550e-12" iyy="6.2704e-06" iyz="1.3147e-08" izz="2.9028e-06"/></inertial>
  </link>''' % [i, i, i, _f(MOTOR_Z), i, MESHES, _f(CLAMPB_Z)])
	s.append('''  <joint name="clampB%d" type="prismatic">
	<parent link="hub%d"/><child link="bar%d"/><origin xyz="%s 0 %s" rpy="0 0 %s"/><axis xyz="0 -1 0"/>
	<limit lower="%s" upper="%s" effort="20" velocity="0.05"/><dynamics damping="0.5"/>
  </joint>''' % [i, i, i, _f(r0), _f(CLAMPB_Z), _f(PI / 2.0), _f(R_MIN - r0), _f(R_MAX - r0)])
	s.append(_bar_link("bar%d" % i))
	var tz := top_z - (i - 1) * LAYER_DROP + PIVOT_Z + TRACK_FLOOR
	var tl := 0.03 if i == 1 else track_len   # layer 1's motor never moves
	for side in [["L", -TRACK_X], ["R", TRACK_X]]:
		var name := "track%d_%s" % [i, side[0]]
		s.append(_fixed(name + "_fixed", "world", name, "%s 0 %s" % [_f(side[1]), _f(tz)]))
		s.append('''  <link name="%s">
	<visual><origin xyz="0 0 -0.00075"/><geometry><box size="0.020 %s 0.0015"/></geometry><material name="alu"/></visual>
	<visual><origin xyz="-0.00925 0 0.0035"/><geometry><box size="0.0015 %s 0.010"/></geometry><material name="alu"/></visual>
	<visual><origin xyz="0.00925 0 0.0035"/><geometry><box size="0.0015 %s 0.010"/></geometry><material name="alu"/></visual>
  </link>''' % [name, _f(tl), _f(tl), _f(tl)])
	return "\n".join(s)


static func _bar_link(name: String) -> String:
	return '''  <link name="%s">
	<visual><geometry><mesh filename="%sbar.stl" scale="0.001 0.001 0.001"/></geometry><material name="alu"/></visual>
	<collision><origin xyz="0 0.086 0"/><geometry><box size="0.02 0.2 0.02"/></geometry></collision>
	<inertial><origin xyz="-0.00000 0.08600 0.00000"/><mass value="0.1000"/><inertia ixx="3.3741e-04" ixy="-8.6845e-21" ixz="-3.3719e-10" iyy="8.1483e-06" iyz="-3.5730e-21" izz="3.3741e-04"/></inertial>
  </link>''' % [name, MESHES]


static func _fixed(name: String, parent: String, child: String, xyz: String) -> String:
	return '  <joint name="%s" type="fixed"><parent link="%s"/><child link="%s"/><origin xyz="%s"/></joint>' % [name, parent, child, xyz]


static func _materials() -> String:
	return '''  <material name="orange"><color rgba="0.88 0.54 0.12 1"/></material>
  <material name="alu"><color rgba="0.75 0.77 0.80 1"/></material>
  <material name="dark"><color rgba="0.25 0.27 0.30 1"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1"/></material>
  <material name="steel"><color rgba="0.55 0.57 0.60 1"/></material>'''


static func _f(v: float) -> String:
	return String.num(v, 8)
